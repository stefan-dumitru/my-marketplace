// Prisma schema. See specifications/data-model.md for the full target model.
//
// Note: Auth.js's Credentials provider never creates a database session (confirmed against
// @auth/core's actual callback code, not just docs) — sessions are JWT-based, with a
// `sessionVersion` counter here used to force-invalidate outstanding tokens server-side (see
// src/lib/auth.ts). The Account/Session adapter tables aren't needed without an OAuth provider;
// add them back if one is introduced later.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  buyer
  seller
  admin
}

enum UserStatus {
  active
  suspended
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  name            String
  phone           String?
  role            UserRole   @default(buyer)
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?
  suspendedAt     DateTime?
  // Set when the user exercises their GDPR deletion right: the row is kept (Order/Review FKs
  // depend on it) but every PII field on it is overwritten — see data-model.md > User > Lifecycle
  // and users.ts's anonymizeUserById. Deliberately a timestamp rather than a UserStatus value:
  // both auth checks test `status === "suspended"` exactly, so a new enum value would fail open.
  anonymizedAt    DateTime?
  // Bump to force-invalidate every outstanding JWT for this user (logout-everywhere, suspension,
  // role/privilege change) — see src/lib/auth.ts's jwt callback.
  sessionVersion  Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sellerProfile SellerProfile?
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  auditLogs     AuditLog[]
  addresses     Address[]
  notifications Notification[]

  @@map("users")
}

enum NotificationType {
  return_request_submitted
  order_delivered
  return_rejected
  return_approved
  seller_application_received
  seller_application_approved
  seller_application_rejected
  seller_suspended
  seller_reinstated
  import_completed
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@map("notifications")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- Catalog + seller onboarding ---
// Product moderation (ProductStatus beyond `active`) and Stripe Connect payouts aren't built yet
// — see specifications/data-model.md and the "Product Catalog + Seller Onboarding" plan.

enum SellerStatus {
  pending
  approved
  suspended
  rejected
}

enum ProductStatus {
  draft
  pending_review
  active
  inactive
  rejected
}

model SellerProfile {
  id                         String       @id @default(cuid())
  userId                     String       @unique
  storeName                  String
  storeSlug                  String       @unique
  description                String?
  logoUrl                    String?
  businessRegistrationNumber String
  stripeConnectAccountId     String?
  payoutsEnabled             Boolean      @default(false)
  commissionRateOverride     Decimal?     @db.Decimal(5, 4)
  status                     SellerStatus @default(pending)
  appliedAt                  DateTime     @default(now())
  approvedAt                 DateTime?
  suspendedAt                DateTime?

  user          User          @relation(fields: [userId], references: [id])
  products      Product[]
  sellerOrders  SellerOrder[]
  importBatches ImportBatch[]
  payouts       Payout[]

  @@map("seller_profiles")
}

enum PayoutStatus {
  pending
  paid
  failed
}

/**
 * One Stripe Connect transfer per seller per batch run — not per SellerOrder. `periodStart`/
 * `periodEnd` are the min/max `deliveredAt` among the orders this payout covers, so "which orders
 * are in this payout" is always re-derivable by date range + seller rather than needing a join
 * table (see data-model.md > Payout). A given SellerOrder's payout amount is included in exactly
 * one Payout — enforced by the release job only ever selecting orders with `payoutAt: null`.
 */
model Payout {
  id               String       @id @default(cuid())
  sellerId         String
  periodStart      DateTime
  periodEnd        DateTime
  amount           Decimal      @db.Decimal(10, 2)
  stripeTransferId String?      @unique
  status           PayoutStatus @default(pending)
  paidAt           DateTime?
  createdAt        DateTime     @default(now())

  seller SellerProfile @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@map("payouts")
}

enum ImportMode {
  add_only
  full_replace
  attribute_update
}

enum ImportBatchStatus {
  pending
  processing
  completed
  failed
}

enum ImportRecordAction {
  created
  updated
  skipped
  failed
  deactivated
}

model ImportBatch {
  id            String            @id @default(cuid())
  sellerId      String
  mode          ImportMode
  status        ImportBatchStatus @default(pending)
  totalRows     Int
  succeededRows Int               @default(0)
  failedRows    Int               @default(0)
  startedAt     DateTime          @default(now())
  completedAt   DateTime?

  seller  SellerProfile       @relation(fields: [sellerId], references: [id])
  records ImportBatchRecord[]

  @@index([sellerId])
  @@map("import_batches")
}

model ImportBatchRecord {
  id            String             @id @default(cuid())
  importBatchId String
  sku           String
  action        ImportRecordAction
  errorMessage  String?
  beforeValue   Json?
  afterValue    Json?

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id])

  @@index([importBatchId])
  @@map("import_batch_records")
}

model Category {
  id                    String  @id @default(cuid())
  name                  String
  slug                  String  @unique
  parentId              String?
  imageUrl              String?
  isActive              Boolean @default(true)
  defaultCommissionRate Decimal @db.Decimal(5, 4)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id                String                   @id @default(cuid())
  sellerId          String
  categoryId        String
  sku               String
  name              String
  slug              String                   @unique
  description       String?
  brand             String?
  images            String[]                 @default([])
  status            ProductStatus            @default(draft)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  activatedAt       DateTime?
  deactivatedAt     DateTime?
  // Bulk import isn't built yet — column reserved for when it is (data-model.md).
  lastImportBatchId String?
  // Generated column (see the migration.sql for this field) — never read/written through Prisma
  // Client, only ever queried via $queryRaw in products.ts's searchActiveProductIds.
  searchVector      Unsupported("tsvector")?

  seller   SellerProfile    @relation(fields: [sellerId], references: [id])
  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  reviews  Review[]

  @@unique([sellerId, sku])
  @@index([sellerId])
  @@index([status, createdAt])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  sku            String
  attributes     Json     @default("{}")
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  stockQty       Int      @default(0)

  product Product @relation(fields: [productId], references: [id])

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// --- Cart + checkout ---
// No guest cart, no reusable Address book, no shipping fee/tax, no stock-reservation/TTL, no
// Stripe Connect payouts — see the "Cart & Checkout" plan for why each is deferred.

enum OrderStatus {
  pending_payment
  paid
  payment_failed
}

enum SellerOrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
  returned
}

enum ReturnRequestStatus {
  pending
  approved
  rejected
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id               String @id @default(cuid())
  cartId           String
  productVariantId String
  quantity         Int

  cart           Cart           @relation(fields: [cartId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productVariantId])
  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id                      String      @id @default(cuid())
  orderNumber             String      @unique
  buyerId                 String
  status                  OrderStatus @default(pending_payment)
  totalAmount             Decimal     @db.Decimal(10, 2)
  currency                String      @default("RON")
  shippingAddressSnapshot Json
  createdAt               DateTime    @default(now())

  buyer        User          @relation(fields: [buyerId], references: [id])
  sellerOrders SellerOrder[]
  payment      Payment?

  @@index([buyerId])
  @@map("orders")
}

model SellerOrder {
  id               String            @id @default(cuid())
  orderId          String
  sellerId         String
  status           SellerOrderStatus @default(pending)
  subtotal         Decimal           @db.Decimal(10, 2)
  commissionAmount Decimal           @db.Decimal(10, 2)
  payoutAmount     Decimal           @default(0) @db.Decimal(10, 2)
  trackingNumber   String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  // Distinct from cancelledAt so a cancel retry can tell "DB side done" from "refund still
  // pending" and only redo the Stripe call, not the stock release — see seller-order-service.ts.
  refundedAt       DateTime?
  payoutAt         DateTime?
  // Legacy: the pre-Payout-model release flow set this per order. No longer written to — a
  // paid-out order's transfer now lives on the Payout row that covers it (see Payout above);
  // this column is kept only so historical pre-migration rows aren't lost.
  stripeTransferId String?

  order         Order          @relation(fields: [orderId], references: [id])
  seller        SellerProfile  @relation(fields: [sellerId], references: [id])
  items         OrderItem[]
  returnRequest ReturnRequest?

  @@index([orderId])
  @@index([sellerId])
  @@map("seller_orders")
}

model ReturnRequest {
  id            String              @id @default(cuid())
  sellerOrderId String              @unique
  reason        String
  status        ReturnRequestStatus @default(pending)
  requestedAt   DateTime            @default(now())
  resolvedAt    DateTime?

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id])

  @@map("return_requests")
}

model OrderItem {
  id                  String  @id @default(cuid())
  sellerOrderId       String
  productVariantId    String
  productNameSnapshot String
  unitPriceSnapshot   Decimal @db.Decimal(10, 2)
  quantity            Int
  lineTotal           Decimal @db.Decimal(10, 2)

  sellerOrder    SellerOrder    @relation(fields: [sellerOrderId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  review         Review?

  @@index([sellerOrderId])
  @@index([productVariantId])
  @@map("order_items")
}

enum ReviewStatus {
  pending
  approved
  rejected
}

model Review {
  id          String       @id @default(cuid())
  productId   String
  buyerId     String
  orderItemId String       @unique
  rating      Int
  title       String
  body        String
  status      ReviewStatus @default(pending)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  product   Product   @relation(fields: [productId], references: [id])
  buyer     User      @relation(fields: [buyerId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([productId, status])
  @@index([status])
  @@map("reviews")
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  stripePaymentIntentId String?
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("RON")
  status                PaymentStatus @default(pending)
  paidAt                DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  beforeValue Json?
  afterValue  Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String?
  recipientName String
  line1         String
  line2         String?
  city          String
  county        String
  postalCode    String
  country       String   @default("România")
  phone         String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("addresses")
}

// Fixed-window counter, not sliding-window/token-bucket — matches security.md's explicit
// "basic... not adaptive/behavioral" scope for v1 rate limiting. No relation to any other
// model: `key` is an opaque caller-defined string (e.g. `login:<email>`, `checkout:<userId>`).
model RateLimitBucket {
  id         String   @id @default(cuid())
  key        String   @unique
  count      Int      @default(1)
  windowEnds DateTime

  @@map("rate_limit_buckets")
}
