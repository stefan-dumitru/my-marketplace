// Prisma schema. See specifications/data-model.md for the full target model.
//
// Note: Auth.js's Credentials provider never creates a database session (confirmed against
// @auth/core's actual callback code, not just docs) — sessions are JWT-based, with a
// `sessionVersion` counter here used to force-invalidate outstanding tokens server-side (see
// src/lib/auth.ts). The Account/Session adapter tables aren't needed without an OAuth provider;
// add them back if one is introduced later.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  buyer
  seller
  admin
}

enum UserStatus {
  active
  suspended
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  name            String
  phone           String?
  role            UserRole   @default(buyer)
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?
  suspendedAt     DateTime?
  // Bump to force-invalidate every outstanding JWT for this user (logout-everywhere, suspension,
  // role/privilege change) — see src/lib/auth.ts's jwt callback.
  sessionVersion  Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sellerProfile SellerProfile?

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- Catalog + seller onboarding ---
// Product moderation (ProductStatus beyond `active`) and Stripe Connect payouts aren't built yet
// — see specifications/data-model.md and the "Product Catalog + Seller Onboarding" plan.

enum SellerStatus {
  pending
  approved
  suspended
  rejected
}

enum ProductStatus {
  draft
  pending_review
  active
  inactive
  rejected
}

model SellerProfile {
  id                         String       @id @default(cuid())
  userId                     String       @unique
  storeName                  String
  storeSlug                  String       @unique
  description                String?
  logoUrl                    String?
  businessRegistrationNumber String
  stripeConnectAccountId     String?
  commissionRateOverride     Decimal?     @db.Decimal(5, 4)
  status                     SellerStatus @default(pending)
  appliedAt                  DateTime     @default(now())
  approvedAt                 DateTime?
  suspendedAt                DateTime?

  user     User      @relation(fields: [userId], references: [id])
  products Product[]

  @@map("seller_profiles")
}

model Category {
  id                    String  @id @default(cuid())
  name                  String
  slug                  String  @unique
  parentId              String?
  imageUrl              String?
  isActive              Boolean @default(true)
  defaultCommissionRate Decimal @db.Decimal(5, 4)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id                String        @id @default(cuid())
  sellerId          String
  categoryId        String
  sku               String
  name              String
  slug              String        @unique
  description       String?
  brand             String?
  images            String[]      @default([])
  status            ProductStatus @default(draft)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  activatedAt       DateTime?
  deactivatedAt     DateTime?
  // Bulk import isn't built yet — column reserved for when it is (data-model.md).
  lastImportBatchId String?

  seller   SellerProfile    @relation(fields: [sellerId], references: [id])
  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]

  @@unique([sellerId, sku])
  @@index([sellerId])
  @@index([status, createdAt])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  sku            String
  attributes     Json     @default("{}")
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  stockQty       Int      @default(0)

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_variants")
}
