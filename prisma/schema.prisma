// Prisma schema. See specifications/data-model.md for the full target model.
//
// Note: Auth.js's Credentials provider never creates a database session (confirmed against
// @auth/core's actual callback code, not just docs) — sessions are JWT-based, with a
// `sessionVersion` counter here used to force-invalidate outstanding tokens server-side (see
// src/lib/auth.ts). Google OAuth (added alongside Credentials) is wired the same way, without an
// Account/Session adapter table: its provider's own `profile()` callback does the lookup-or-
// create against this same `users` table directly (see auth.ts), so a Google sign-in and a
// password sign-in for the same email resolve to one User row with no separate linking table
// needed.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  buyer
  seller
  admin
}

enum UserStatus {
  active
  suspended
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  // Nullable — an account created via Google OAuth has no password until/unless the user later
  // sets one (no such flow exists yet). authorize() in auth.ts must null-check before comparing;
  // an OAuth-only user attempting the Credentials form is rejected the same generic way a wrong
  // password is, not a distinct error (no enumeration of which accounts are OAuth-only).
  passwordHash    String?
  name            String
  phone           String?
  role            UserRole   @default(buyer)
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?
  suspendedAt     DateTime?
  // Set when the user exercises their GDPR deletion right: the row is kept (Order/Review FKs
  // depend on it) but every PII field on it is overwritten — see data-model.md > User > Lifecycle
  // and users.ts's anonymizeUserById. Deliberately a timestamp rather than a UserStatus value:
  // both auth checks test `status === "suspended"` exactly, so a new enum value would fail open.
  anonymizedAt    DateTime?
  // Bump to force-invalidate every outstanding JWT for this user (logout-everywhere, suspension,
  // role/privilege change) — see src/lib/auth.ts's jwt callback.
  sessionVersion  Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sellerProfile     SellerProfile?
  cart              Cart?
  wishlist          Wishlist?
  orders            Order[]
  reviews           Review[]
  auditLogs         AuditLog[]
  addresses         Address[]
  notifications     Notification[]
  couponsCreated    Coupon[]
  couponRedemptions CouponRedemption[]
  // Set the first time the user starts a subscription checkout; every Stripe event is mapped back
  // to a user through this (never through client-supplied ids).
  stripeCustomerId  String?            @unique
  subscription      Subscription?

  @@map("users")
}

enum NotificationType {
  return_request_submitted
  order_delivered
  return_rejected
  return_approved
  seller_application_received
  seller_application_approved
  seller_application_rejected
  seller_suspended
  seller_reinstated
  import_completed
  low_stock_alert
  order_confirmed
  order_payment_failed
  order_shipped
  review_reminder
  seller_order_received
  payout_processed
  product_pending_review
  webhook_failure
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@map("notifications")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Deliberately a separate table from VerificationToken rather than a shared `purpose` column:
// both are keyed by `identifier` (email) with "at most one outstanding token" semantics, and a
// shared table would mean requesting a password reset silently invalidates a pending email-
// verification link for the same address (and vice versa) — two unrelated flows stepping on each
// other. Shorter TTL than email verification (1h vs 24h) since a stale reset link is a more
// sensitive credential to leave valid.
model PasswordResetToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("password_reset_tokens")
}

// --- Catalog + seller onboarding ---
// Product moderation (ProductStatus beyond `active`) and Stripe Connect payouts aren't built yet
// — see specifications/data-model.md and the "Product Catalog + Seller Onboarding" plan.

enum SellerStatus {
  pending
  approved
  suspended
  rejected
}

enum ProductStatus {
  draft
  pending_review
  active
  inactive
  rejected
}

model SellerProfile {
  id                         String       @id @default(cuid())
  userId                     String       @unique
  storeName                  String
  storeSlug                  String       @unique
  description                String?
  logoUrl                    String?
  businessRegistrationNumber String
  stripeConnectAccountId     String?
  payoutsEnabled             Boolean      @default(false)
  commissionRateOverride     Decimal?     @db.Decimal(5, 4)
  status                     SellerStatus @default(pending)
  appliedAt                  DateTime     @default(now())
  approvedAt                 DateTime?
  suspendedAt                DateTime?

  user          User               @relation(fields: [userId], references: [id])
  products      Product[]
  sellerOrders  SellerOrder[]
  importBatches ImportBatch[]
  payouts       Payout[]
  dailySales    DailySellerSales[]

  @@map("seller_profiles")
}

enum PayoutStatus {
  pending
  paid
  failed
}

/**
 * One Stripe Connect transfer per seller per batch run — not per SellerOrder. `periodStart`/
 * `periodEnd` are the min/max `deliveredAt` among the orders this payout covers, so "which orders
 * are in this payout" is always re-derivable by date range + seller rather than needing a join
 * table (see data-model.md > Payout). A given SellerOrder's payout amount is included in exactly
 * one Payout — enforced by the release job only ever selecting orders with `payoutAt: null`.
 */
model Payout {
  id               String       @id @default(cuid())
  sellerId         String
  periodStart      DateTime
  periodEnd        DateTime
  amount           Decimal      @db.Decimal(10, 2)
  stripeTransferId String?      @unique
  status           PayoutStatus @default(pending)
  paidAt           DateTime?
  createdAt        DateTime     @default(now())

  seller SellerProfile @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@map("payouts")
}

// Denormalized daily aggregates, populated by a nightly background job (computeDailySalesRollup
// in sales-rollup-service.ts) rather than aggregated from raw Order/SellerOrder rows on every
// dashboard load — see functional.md > Search & Reporting and operations.md > Background Jobs.
// `date` is always truncated to midnight UTC, one row per seller per day; monthly figures are a
// plain SUM over that month's rows, not a separate table.
model DailySellerSales {
  id               String   @id @default(cuid())
  sellerId         String
  date             DateTime @db.Date
  orderCount       Int
  revenue          Decimal  @db.Decimal(10, 2)
  commissionAmount Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())

  seller SellerProfile @relation(fields: [sellerId], references: [id])

  @@unique([sellerId, date])
  @@index([sellerId])
  @@map("daily_seller_sales")
}

/**
 * Platform-wide counterpart of DailySellerSales — one row per day, summed across every seller.
 */
model DailyPlatformSales {
  id               String   @id @default(cuid())
  date             DateTime @unique @db.Date
  orderCount       Int
  gmv              Decimal  @db.Decimal(10, 2)
  commissionAmount Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())

  @@map("daily_platform_sales")
}

enum ImportMode {
  add_only
  full_replace
  attribute_update
}

enum ImportBatchStatus {
  pending
  processing
  completed
  failed
}

enum ImportRecordAction {
  created
  updated
  skipped
  failed
  deactivated
}

model ImportBatch {
  id            String            @id @default(cuid())
  sellerId      String
  mode          ImportMode
  status        ImportBatchStatus @default(pending)
  totalRows     Int
  succeededRows Int               @default(0)
  failedRows    Int               @default(0)
  startedAt     DateTime          @default(now())
  completedAt   DateTime?

  seller  SellerProfile       @relation(fields: [sellerId], references: [id])
  records ImportBatchRecord[]

  @@index([sellerId])
  @@map("import_batches")
}

model ImportBatchRecord {
  id            String             @id @default(cuid())
  importBatchId String
  sku           String
  action        ImportRecordAction
  errorMessage  String?
  beforeValue   Json?
  afterValue    Json?

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id])

  @@index([importBatchId])
  @@map("import_batch_records")
}

model Category {
  id                    String  @id @default(cuid())
  name                  String
  slug                  String  @unique
  parentId              String?
  imageUrl              String?
  isActive              Boolean @default(true)
  defaultCommissionRate Decimal @db.Decimal(5, 4)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id                String                   @id @default(cuid())
  sellerId          String
  categoryId        String
  sku               String
  name              String
  slug              String                   @unique
  description       String?
  brand             String?
  images            String[]                 @default([])
  status            ProductStatus            @default(draft)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  activatedAt       DateTime?
  deactivatedAt     DateTime?
  // Bulk import isn't built yet — column reserved for when it is (data-model.md).
  lastImportBatchId String?
  // Generated column (see the migration.sql for this field) — never read/written through Prisma
  // Client, only ever queried via $queryRaw in products.ts's searchActiveProductIds.
  searchVector      Unsupported("tsvector")?

  seller        SellerProfile    @relation(fields: [sellerId], references: [id])
  category      Category         @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@unique([sellerId, sku])
  @@index([sellerId])
  @@index([status, createdAt])
  @@map("products")
}

model ProductVariant {
  id                String    @id @default(cuid())
  productId         String
  sku               String
  attributes        Json      @default("{}")
  price             Decimal   @db.Decimal(10, 2)
  compareAtPrice    Decimal?  @db.Decimal(10, 2)
  stockQty          Int       @default(0)
  // Set the moment stock first crosses at/under LOW_STOCK_THRESHOLD (see lib/constants.ts),
  // so the low-stock alert fires once per dip, not once per sale while it stays low. Cleared
  // back to null once the seller restocks above the threshold (see products.ts).
  lowStockAlertedAt DateTime?

  product Product @relation(fields: [productId], references: [id])

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// --- Cart + checkout ---
// No guest cart, no reusable Address book, no shipping fee/tax, no stock-reservation/TTL, no
// Stripe Connect payouts — see the "Cart & Checkout" plan for why each is deferred.

enum OrderStatus {
  pending_payment
  paid
  payment_failed
}

enum SellerOrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
  returned
}

enum ReturnRequestStatus {
  pending
  approved
  rejected
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  // The promo code the buyer applied on the cart page. Only a *selection* — it is re-validated on
  // every render and again inside the checkout transaction, never trusted as already-valid.
  couponId  String?
  updatedAt DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [id])
  coupon Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items  CartItem[]

  @@map("carts")
}

model CartItem {
  id               String   @id @default(cuid())
  cartId           String
  productVariantId String
  quantity         Int
  // Cart.updatedAt only changes at cart creation (upsert's create branch) — CartItem writes never
  // touch the parent row, so "abandoned" line items are detected off this timestamp instead (see
  // the cart-purge background job in inngest/functions.ts).
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart           Cart           @relation(fields: [cartId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productVariantId])
  @@index([cartId])
  @@map("cart_items")
}

// Unlike Cart/CartItem, a wishlist entry is product-level, not variant-level — it records
// "the buyer wants this product," not a specific variant/quantity intent (that decision is
// deferred to whenever they actually move it to the cart). No quantity field for the same reason.
model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @unique
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id])
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@map("wishlist_items")
}

model Order {
  id                      String      @id @default(cuid())
  orderNumber             String      @unique
  buyerId                 String
  status                  OrderStatus @default(pending_payment)
  // What the buyer actually pays: Σ SellerOrder.subtotal − discountAmount. Platform-funded coupons
  // never touch SellerOrder.subtotal/commission/payout, so sellers are paid exactly as if no
  // coupon had been used — the platform absorbs the discount out of its own margin.
  totalAmount             Decimal     @db.Decimal(10, 2)
  currency                String      @default("RON")
  shippingAddressSnapshot Json
  couponId                String?
  // Frozen at purchase time, like every other snapshot on an order — renaming/deactivating the
  // coupon later must not change what this order says it used.
  couponCodeSnapshot      String?
  discountAmount          Decimal     @default(0) @db.Decimal(10, 2)
  // Σ SellerOrder.shippingCharged — what the buyer paid for shipping. Part of totalAmount.
  shippingAmount          Decimal     @default(0) @db.Decimal(10, 2)
  createdAt               DateTime    @default(now())

  buyer            User              @relation(fields: [buyerId], references: [id])
  coupon           Coupon?           @relation(fields: [couponId], references: [id])
  couponRedemption CouponRedemption?
  sellerOrders     SellerOrder[]
  payment          Payment?

  @@index([buyerId])
  @@map("orders")
}

model SellerOrder {
  id                String            @id @default(cuid())
  orderId           String
  sellerId          String
  status            SellerOrderStatus @default(pending)
  subtotal          Decimal           @db.Decimal(10, 2)
  // This sub-order's share of Order.discountAmount (allocated pro rata to subtotal, summing
  // exactly to the order discount). Not seller-funded: used only to refund the buyer what they
  // actually paid for this sub-order on cancel/return — see seller-order-service.ts.
  discountAllocated Decimal           @default(0) @db.Decimal(10, 2)
  // shippingFee: owed to the seller (added to payoutAmount, no commission). shippingCharged: what
  // the buyer actually paid — equal to shippingFee, or 0 if waived (free-shipping subscription,
  // where the platform pays the seller the fee instead). Both frozen at sale time.
  shippingFee       Decimal           @default(0) @db.Decimal(10, 2)
  shippingCharged   Decimal           @default(0) @db.Decimal(10, 2)
  commissionAmount  Decimal           @db.Decimal(10, 2)
  payoutAmount      Decimal           @default(0) @db.Decimal(10, 2)
  trackingNumber    String?
  // FanCourier label generation: URL to the PDF, or null if no label has been generated yet.
  labelUrl          String?
  // Last time we successfully polled FanCourier's tracking API for this shipment. Used to detect
  // stale status and gate notification triggers (notify buyer only on real status changes).
  lastTrackedAt     DateTime?
  // Current status from FanCourier's tracking API: "pending", "in_transit", "out_for_delivery",
  // "delivered", "exception", etc. Null until the first successful tracking fetch.
  carrierStatus     String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  // Distinct from cancelledAt so a cancel retry can tell "DB side done" from "refund still
  // pending" and only redo the Stripe call, not the stock release — see seller-order-service.ts.
  refundedAt        DateTime?
  payoutAt          DateTime?
  // Legacy: the pre-Payout-model release flow set this per order. No longer written to — a
  // paid-out order's transfer now lives on the Payout row that covers it (see Payout above);
  // this column is kept only so historical pre-migration rows aren't lost.
  stripeTransferId  String?

  order         Order          @relation(fields: [orderId], references: [id])
  seller        SellerProfile  @relation(fields: [sellerId], references: [id])
  items         OrderItem[]
  returnRequest ReturnRequest?

  @@index([orderId])
  @@index([sellerId])
  @@map("seller_orders")
}

model ReturnRequest {
  id            String              @id @default(cuid())
  sellerOrderId String              @unique
  reason        String
  status        ReturnRequestStatus @default(pending)
  requestedAt   DateTime            @default(now())
  resolvedAt    DateTime?

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id])

  @@map("return_requests")
}

model OrderItem {
  id                  String  @id @default(cuid())
  sellerOrderId       String
  productVariantId    String
  productNameSnapshot String
  unitPriceSnapshot   Decimal @db.Decimal(10, 2)
  quantity            Int
  lineTotal           Decimal @db.Decimal(10, 2)

  sellerOrder    SellerOrder    @relation(fields: [sellerOrderId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  review         Review?

  @@index([sellerOrderId])
  @@index([productVariantId])
  @@map("order_items")
}

enum ReviewStatus {
  // No admin pre-publish gate — every review is auto-approved on submission (see
  // review-service.ts's submitReview). `pending` is kept only because it's a real value in
  // existing rows/migrations; nothing can create one anymore. Post-publish moderation still
  // exists: an admin can flip a review to `rejected` (unpublish it) or back to `approved`
  // (restore it) — see admin/reviews.
  pending
  approved
  rejected
}

model Review {
  id          String       @id @default(cuid())
  productId   String
  buyerId     String
  orderItemId String       @unique
  rating      Int
  title       String
  body        String
  status      ReviewStatus @default(approved)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  product   Product   @relation(fields: [productId], references: [id])
  buyer     User      @relation(fields: [buyerId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([productId, status])
  @@index([status])
  @@map("reviews")
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  stripePaymentIntentId String?
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("RON")
  status                PaymentStatus @default(pending)
  paidAt                DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  beforeValue Json?
  afterValue  Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String?
  recipientName String
  line1         String
  line2         String?
  city          String
  county        String
  postalCode    String
  country       String   @default("România")
  phone         String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("addresses")
}

// Fixed-window counter, not sliding-window/token-bucket — matches security.md's explicit
// "basic... not adaptive/behavioral" scope for v1 rate limiting. No relation to any other
// model: `key` is an opaque caller-defined string (e.g. `login:<email>`, `checkout:<userId>`).
model RateLimitBucket {
  id         String   @id @default(cuid())
  key        String   @unique
  count      Int      @default(1)
  windowEnds DateTime

  @@map("rate_limit_buckets")
}

enum CouponType {
  percentage
  fixed_amount
}

// Admin-created, platform-funded promo codes (see specifications/release-3.md §2). Whole-cart
// scope only in v1 — no per-product/category/seller targeting.
model Coupon {
  id                    String     @id @default(cuid())
  // Stored uppercase; lookups uppercase their input, so codes are case-insensitive.
  code                  String     @unique
  type                  CouponType
  // percentage: 0–100 (percent). fixed_amount: RON.
  value                 Decimal    @db.Decimal(10, 2)
  minOrderAmount        Decimal?   @db.Decimal(10, 2)
  // Cap for percentage codes (a 50% code on a 5,000 RON cart shouldn't be unbounded).
  maxDiscountAmount     Decimal?   @db.Decimal(10, 2)
  startsAt              DateTime?
  expiresAt             DateTime?
  maxRedemptionsTotal   Int?
  maxRedemptionsPerUser Int?
  firstOrderOnly        Boolean    @default(false)
  isActive              Boolean    @default(true)
  // Incremented atomically inside the checkout transaction (conditional UPDATE) — the actual
  // guard against over-redeeming under concurrency. Equals the number of CouponRedemption rows.
  redemptionCount       Int        @default(0)
  createdByUserId       String
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  createdBy   User               @relation(fields: [createdByUserId], references: [id])
  redemptions CouponRedemption[]
  orders      Order[]
  carts       Cart[]

  @@index([isActive])
  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  userId         String
  // One order can redeem at most one coupon (v1), and unique makes a double-insert impossible.
  orderId        String   @unique
  discountAmount Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@index([couponId])
  @@index([userId, couponId])
  @@map("coupon_redemptions")
}

// The free-shipping subscription (one plan, see specifications/release-3.md §3). Stripe is the
// source of truth: this row is a synced copy, rewritten from a fresh stripe.subscriptions.retrieve
// on every relevant webhook, so an out-of-order or redelivered event can't leave it wrong.
model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  stripeSubscriptionId String   @unique
  // Stripe's own status string (active, trialing, past_due, canceled, unpaid, incomplete, ...).
  status               String
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

// FanCourier carrier integration: admin-configured API credentials (one set per environment).
// Credentials are encrypted at rest. Only admins can set these via the admin dashboard.
model CarrierConfig {
  id             String    @id @default(cuid())
  carrier        String    @default("fancourier") // "fancourier" for v1; prepared for multi-carrier
  apiUsername    String // Encrypted
  apiPassword    String // Encrypted
  environment    String    @default("test") // "test" or "production"
  isActive       Boolean   @default(true)
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([carrier, environment])
  @@map("carrier_configs")
}
