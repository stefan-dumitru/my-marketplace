# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Database — local dev default matches the Docker Postgres container documented in the README
# (docker run ... postgres:16, host port 5433 -> container 5432, db "my_marketplace"). Port 5433
# is used instead of the default 5432 to avoid clashing with a native Postgres install on the
# host, if one exists. Use your Neon pooled connection string here for staging/production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/my_marketplace?schema=public"

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Resend (transactional email) — leave unset in development to use the console-log fallback
# in src/lib/email.ts. Required in production; sends fail loudly if missing there.
RESEND_API_KEY=""
EMAIL_FROM="My Marketplace <no-reply@my-marketplace.example>"

# Only used by `npx prisma db seed` (prisma/seed.ts) to create/promote one admin user.
# Not read anywhere at runtime.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
# Secret key only — no publishable key is needed anywhere in this app. Checkout uses Stripe's
# hosted Checkout Session redirect, never Stripe.js/Elements client-side, which is exactly what
# keeps this app's PCI scope at security.md's stated SAQ-A tier.
STRIPE_SECRET_KEY=""

# Webhook signing secret for src/app/api/webhooks/stripe/route.ts. In local dev, get this from
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe`'s own startup output (a
# whsec_... value) — NOT the Dashboard's webhook-endpoint secret, which is a different key tied
# to a different (non-CLI) delivery method.
STRIPE_WEBHOOK_SECRET=""
